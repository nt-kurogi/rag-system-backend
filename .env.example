# =========================
# RAG Backend Configuration
# =========================

# API server port
PORT=8787

# CORS allowed origin (frontend URL)
ALLOWED_ORIGIN=https://green-stone-03f1e0d00.7.azurestaticapps.net

# Optional: if set, frontend must send same value in `api-key` header
BACKEND_API_KEY=

# -------------------------
# Entra Auth (required when enabled)
# -------------------------
ENTRA_AUTH_ENABLED=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# -------------------------
# Azure OpenAI
# -------------------------
# Example: https://my-openai-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-openai-api-key>

# IMPORTANT: deployment name (not model name)
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>

# Optional: split deployments by mode
# If not set, RAG mode falls back to AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_DEPLOYMENT_RAG=

# Backward-compatible GPT-5.6 Sol deployment name.
# Used as the Sol deployment when AZURE_OPENAI_DEPLOYMENT_GPT56_SOL is empty.
AZURE_OPENAI_DEPLOYMENT_GPT56=

# Defaults to the model ID when blank. Override these if the Azure deployment
# names differ from gpt-5.6-sol / gpt-5.6-terra / gpt-5.6-luna.
AZURE_OPENAI_DEPLOYMENT_GPT56_SOL=
AZURE_OPENAI_DEPLOYMENT_GPT56_TERRA=
AZURE_OPENAI_DEPLOYMENT_GPT56_LUNA=

# gpt-5.6-sol, gpt-5.6-terra, or gpt-5.6-luna.
# Falls back to the first configured deployment.
AZURE_OPENAI_GPT56_DEFAULT_MODEL=auto

AZURE_OPENAI_MAX_OUTPUT_TOKENS=8000

# Use the Responses input-token counting endpoint when available.
# If the provider/deployment does not expose it, the API automatically estimates.
AZURE_OPENAI_INPUT_TOKEN_COUNT_ENABLED=true

# Requires Responses API tool support on the configured GPT-5.6 deployment.
IMAGE_GENERATION_ENABLED=true

# Not used in v1 Responses API (kept only for compatibility/reference).
AZURE_OPENAI_API_VERSION=

# -------------------------
# Azure AI Search
# -------------------------
# Example: https://my-search-service.search.windows.net
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-api-key>

# Default index used when request body has no indexName
AZURE_SEARCH_INDEX=<default-index-name>

# -------------------------
# Azure Blob SAS for citations (optional)
# -------------------------
# If your citation URLs point to private Blob Storage, set these to return SAS URLs.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
BLOB_SAS_EXPIRY_MINUTES=30
AZURE_STORAGE_ATTACHMENT_CONTAINER=chat-attachments

# Per-request attachment limits.
ATTACHMENT_MAX_FILE_BYTES=20971520
ATTACHMENT_MAX_REQUEST_BYTES=52428800
ATTACHMENT_MAX_FILES=5

# -------------------------
# Cosmos DB (chat history)
# -------------------------
COSMOS_DB_ENDPOINT=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=rag-chat
COSMOS_DB_CONTAINER=conversations
COSMOS_DB_AUDIT_CONTAINER=audit-logs
COSMOS_DB_USAGE_CONTAINER=usage-counters
COSMOS_DB_ARTIFACT_JOB_CONTAINER=artifact-jobs
ARTIFACT_JOB_RETENTION_DAYS=7

# Number of recent messages sent to GPT-5.6 for conversational context.
CHAT_HISTORY_MAX_MESSAGES=20

# Sliding chat retention period. 0 disables expiration.
CHAT_RETENTION_DAYS=365

# -------------------------
# Per-user usage limits
# -------------------------
# Monthly weighted-token allowance. 0 means unlimited.
MONTHLY_TOKEN_LIMIT_DEFAULT=5000000

# Maximum number of simultaneously running model requests per user (1-20).
CONCURRENT_REQUEST_LIMIT_DEFAULT=3

# Per-user overrides keyed by Entra Object ID or lowercase username/UPN.
# A number is shorthand for monthlyTokenLimit.
# Example: {"00000000-0000-0000-0000-000000000000":{"monthlyTokenLimit":10000000,"concurrentLimit":5},"admin@example.com":{"monthlyTokenLimit":0,"concurrentLimit":10}}
USAGE_LIMIT_OVERRIDES={}

# JST month boundary and abandoned-request recovery window.
USAGE_TIMEZONE_OFFSET_MINUTES=540
USAGE_LEASE_TIMEOUT_SECONDS=900

# Internal quota multipliers by reasoning effort (not OpenAI billing rates).
USAGE_REASONING_EFFORT_WEIGHTS={"none":1,"low":1.1,"medium":1.25,"high":1.5,"xhigh":2}

# Users allowed to open GET /api/usage/admin.
USAGE_DASHBOARD_ADMIN_USER_NAMES=hamano@ntseimitsu.co.jp

# Comma-separated admin users for audit view API access.
# Set either Entra Object IDs (recommended) or usernames/email.
ADMIN_USER_IDS=
ADMIN_USER_NAMES=
